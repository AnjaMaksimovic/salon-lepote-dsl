<!-- AUTO-GENERISANO - NE MENJATI RUČNO -->
<!DOCTYPE html>
<html lang="sr">
<head>
<meta charset="UTF-8">
<title>{{ cls.name }} - lista</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="wrap">
<h1>{{ cls.name }}</h1>
<div class="nav">
  <a href="index.html">&larr; Početna</a><span class="sep">|</span><a href="form_{{ cls.lower }}.html">+ Novi {{ cls.name }}</a>
</div>
<table id="tbl">
<thead><tr>
  <th>id</th>
{% for attr in cls.attributes %}
  <th>{{ attr.label }}</th>
{% endfor %}
{% for fk in cls.fk_fields %}
  <th>{{ fk.label }}</th>
{% endfor %}
{% for role in cls.m2m_create_fields %}
  <th>{{ role|capitalize }}</th>
{% endfor %}
  <th></th>
</tr></thead>
<tbody></tbody>
</table>
</div>
<script>
function ucitajFkLookupe() {
  return Promise.all([
{% for fk in cls.fk_fields %}
    fetch("http://127.0.0.1:8000/{{ fk.ref_table }}/").then(r => r.json()).then(rows => {
      fkLookupi["{{ fk.column_name }}"] = Object.fromEntries(rows.map(o => [o.id, o.{{ fk.display_attr }} ?? ("#" + o.id)]));
    }){{ "," if not loop.last }}
{% endfor %}
  ]);
}
const fkLookupi = {};

function ucitaj() {
  ucitajFkLookupe().then(() => {
    fetch("http://127.0.0.1:8000/{{ cls.lower }}/")
      .then(r => r.json())
      .then(rows => {
        const tbody = document.querySelector("#tbl tbody");
        tbody.innerHTML = "";
        if (rows.length === 0) {
          const colCount = document.querySelectorAll("#tbl thead th").length;
          tbody.innerHTML = `<tr><td colspan="${colCount}" style="text-align:center; color:var(--muted); padding:1.5rem;">
            Nema unosa. <a href="form_{{ cls.lower }}.html">Dodajte prvi.</a></td></tr>`;
          return;
        }
        rows.forEach(row => {
          const tr = document.createElement("tr");
          let html = `<td>${row.id}</td>`;
{% for attr in cls.attributes %}
{% if attr.py_type == "bool" %}
          html += `<td>${row.{{ attr.name }} ? "Da" : "Ne"}</td>`;
{% else %}
          html += `<td>${row.{{ attr.name }} ?? ""}</td>`;
{% endif %}
{% endfor %}
{% for fk in cls.fk_fields %}
          html += `<td>${fkLookupi["{{ fk.column_name }}"][row.{{ fk.column_name }}] ?? row.{{ fk.column_name }}}</td>`;
{% endfor %}
{% for role in cls.m2m_create_fields %}
          html += `<td>${(row.{{ role }} || []).map(o => o.{{ m2m_role_display_attr[role] }}).join(", ")}</td>`;
{% endfor %}
          html += `<td><a class="edit" href="form_{{ cls.lower }}.html?id=${row.id}">izmeni</a><button class="del" data-id="${row.id}">obriši</button></td>`;
          tr.innerHTML = html;
          tbody.appendChild(tr);
        });
        tbody.querySelectorAll("button.del").forEach(btn => {
          btn.addEventListener("click", () => {
            fetch(`http://127.0.0.1:8000/{{ cls.lower }}/${btn.dataset.id}`, { method: "DELETE" })
              .then(() => ucitaj());
          });
        });
      });
  });
}
ucitaj();
</script>
</body>
</html>
