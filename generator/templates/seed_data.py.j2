"""
import argparse
import json
from sqlalchemy import create_engine, event
from sqlalchemy.orm import Session
from generated.entities import Base
from generated import association_tables  # Registers N:N tables.
from generated import repository as repo
from generated import schema


def seed(db):
    created_ids = {}
    payloads = {}
    print("--- Prolaz 1: kreiranje zapisa ---")
{% for cls in classes %}
    data = json.loads({{ cls.sample_body_literal }})
{% for fk in cls.fk_overrides %}
    data["{{ fk.column }}"] = created_ids["{{ fk.ref_class }}"]
{% endfor %}
{% for m in cls.m2m_link_overrides %}
