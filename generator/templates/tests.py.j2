def test_{{ cls.lower }}_many_to_many_links(api):
    client, engine, ids = api
    payload = json.loads({{ cls.sample_body_literal }})
{% for fk in cls.fk_overrides %}
    payload["{{ fk.column }}"] = ids["{{ fk.ref_class }}"]
{% endfor %}
{% for m in cls.m2m_link_overrides %}
    payload["{{ m.role }}_ids"] = [ids["{{ m.ref_class }}"]]
{% endfor %}
{% if cls.name == "Package" %}
    payload["price"] = 0.5
{% endif %}
    response = client.put(f"/{{ cls.lower }}/{ids['{{ cls.name }}']}", json=payload)
    assert response.status_code == 200, response.text
    with Session(engine) as db:
{% for link in cls.m2m_links %}
        table = association_tables.{{ link.table_name }}
        linked_ids = db.scalars(select(table.c.{{ link.target_column }}).where(
            table.c.{{ link.own_column }} == ids["{{ cls.name }}"])).all()
        assert linked_ids == [ids["{{ link.target_class }}"]]
{% endfor %}
    # Removing links must also be persisted.
{% for m in cls.m2m_link_overrides %}
    payload["{{ m.role }}_ids"] = []
{% endfor %}
    response = client.put(f"/{{ cls.lower }}/{ids['{{ cls.name }}']}", json=payload)
{% if cls.name == "Package" %}
    # Empty services would violate the package price rule; keep existing links.
    assert response.status_code == 400, response.text
{% else %}
    assert response.status_code == 200, response.text
{% endif %}
    with Session(engine) as db:
{% for link in cls.m2m_links %}
        table = association_tables.{{ link.table_name }}
        assert db.scalars(select(table.c.{{ link.target_column }}).where(
            table.c.{{ link.own_column }} == ids["{{ cls.name }}"])).all() == {% if cls.name == "Package" %}[ids["{{ link.target_class }}"]]{% else %}[]{% endif %}

{% endfor %}
{% endif %}
{% endfor %}
